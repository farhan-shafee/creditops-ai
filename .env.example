# Copy to .env locally; never commit .env. Server-side only.
DATABASE_URL=sqlite+aiosqlite:///./artifacts/creditops.db
# For Docker/Neon use postgresql+asyncpg://USER:PASSWORD@HOST/creditops
# On Neon enable TLS with DATABASE_REQUIRE_SSL=true.
DATABASE_REQUIRE_SSL=false
API_BASE_URL=http://127.0.0.1:8000
TELEMETRY_MODE=persisted
PUBLIC_DEMO=true
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Configure an unpredictable server-side admin key before enabling LIVE_AI.
ADMIN_API_KEY=
INVESTIGATION_TIMEOUT_SECONDS=45
DIAGNOSTIC_TIMEOUT_SECONDS=10
PROVIDER_TIMEOUT_SECONDS=20
MAX_PROVIDER_TURNS=12
MAX_DIAGNOSTIC_CALLS=12
MAX_NO_PROGRESS_CALLS=2
# Owned MCP subprocess calls this fixed API; use its internal listening port.
MCP_API_URL=http://127.0.0.1:8000
# Empty disables paid provider requests even when keys exist. Approval is separate.
LIVE_MAX_SPEND_USD=
MAX_INVESTIGATIONS_PER_WINDOW=10
RATE_LIMIT_WINDOW_SECONDS=300
# Optional provider prices; empty means unavailable, never estimated from guesses.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
ANTHROPIC_INPUT_USD_PER_MILLION=
ANTHROPIC_OUTPUT_USD_PER_MILLION=
# Optional private embedding index. Public demo never makes paid query embeddings.
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
