{
  "name": "creditops-ai",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "showcase": "node scripts/showcase.mjs",
    "dev:web": "pnpm --filter @creditops/web dev",
    "build": "pnpm --filter @creditops/web build",
    "lint": "node scripts/check.mjs lint",
    "typecheck": "pnpm --filter @creditops/web typecheck",
    "test": "node scripts/check.mjs test",
    "e2e": "pnpm --filter @creditops/web e2e",
    "e2e:showcase": "pnpm --filter @creditops/web exec playwright test --config=playwright.showcase.config.ts",
    "test:showcase-startup": "node --test scripts/check-showcase-startup.mjs",
    "test:dependencies": "node --test scripts/check-lint-dependencies.mjs",
    "test:lifecycle": "node --test scripts/check-webserver-lifecycle.mjs"
  }
}
